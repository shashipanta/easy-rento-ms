pipeline {
    agent any

    parameters {
        booleanParam(
            name: 'DEPLOY',
            defaultValue: true,
            description: 'Deploy locally after build?'
        )
        string(
            name: 'GIT_BRANCH',
            defaultValue: 'main',
            description: 'Git branch to fetch latest code from'
        )
        string(
            name: 'PORT',
            defaultValue: '8091',
            description: 'Port on which the application shall run'
        )
        string(
            name: 'SERVICE_FOLDER',
            defaultValue: 'auth-server',
            description: 'Microservice folder inside the main mono-repo'
        )
    }

    environment {
        SERVICE_NAME = "${params.SERVICE_FOLDER}"
    }

    stages {
        stage('Checkout Latest Code') {
            steps {
                echo "Fetching latest code from branch ${params.GIT_BRANCH}..."
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "refs/heads/${params.GIT_BRANCH}"]],
                    userRemoteConfigs: [[
                        url: 'git@github.com:shashipanta/easy-rento-ms.git',
                        credentialsId: 'github-ssh'
                    ]]
                ])
            }
        }

        stage('Debug workspace') {
            steps {
                sh 'ls -la'
            }
        }

        stage('Build JAR') {
            steps {
                dir("${params.SERVICE_FOLDER}") {
                    echo "Building JAR for ${params.SERVICE_FOLDER}..."
                    sh './mvnw clean package -DskipTests'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir("${params.SERVICE_FOLDER}") {
                    echo "Building Docker image for ${SERVICE_NAME}..."
                    script {
                         docker.build("${env.SERVICE_NAME}:latest")
                    }
                }
            }
        }

        stage('Deploy Locally (Optional)') {
            when { expression { params.DEPLOY == true } }
            steps {
                dir("${params.SERVICE_FOLDER}") {
                    script {
                        def envVars = [:]
                        if (fileExists('.env')) {
                            envVars = readFile('.env').split('\n')
                                .findAll { it.contains('=') }
                                .collect { it.split('=') }
                                .collectEntries { [(it[0]): it[1]] }
                        }

                        def port = envVars['PORT'] ?: params.PORT

                        sh """
                            docker stop ${SERVICE_NAME} || true
                            docker rm ${SERVICE_NAME} || true
                            docker run -d --name ${SERVICE_NAME} -p ${port}:${port} --env-file .env ${SERVICE_NAME}:latest
                        """
                    }
                }
            }
        }
    }

    post {
        success { echo "✅ ${SERVICE_NAME} Docker image built and deployed!" }
        failure { echo "❌ ${SERVICE_NAME} build/deploy failed!" }
    }
}
