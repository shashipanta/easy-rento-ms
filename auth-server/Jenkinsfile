pipeline {
    agent {
        // Use a Jenkins agent with Docker installed
        label 'docker-agent'
    }

    parameters {
        booleanParam(
            name: 'DEPLOY',
            defaultValue: true,
            description: 'Deploy locally after build?'
        )
        string(
            name: 'GIT_BRANCH',
            defaultValue: 'main',
            description: 'Git branch to build'
        )
        string(
            name: 'PORT',
            defaultValue: '8091',
            description: 'Port to run service locally'
        )
    }

    environment {
        SERVICE_NAME = "${env.WORKSPACE.split('/').last()}"
    }

    stages {

        stage('Checkout Code') {
            steps {
                echo "Checking out branch ${params.GIT_BRANCH}"
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "refs/heads/${params.GIT_BRANCH}"]],
                    userRemoteConfigs: [[
                        url: 'git@github.com:shashipanta/easy-rento-ms.git',
                        credentialsId: 'github-ssh'
                    ]]
                ])
            }
        }

        stage('Debug Workspace') {
            steps {
                sh 'pwd && ls -la'
            }
        }

        stage('Build JAR') {
            steps {
                dir("${env.SERVICE_NAME}") {   // go into microservice folder
                    sh './mvnw clean package -DskipTests'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir("${env.SERVICE_NAME}") {
                    script {
                        docker.build("${env.SERVICE_NAME}:latest", ".")
                    }
                }
            }
        }

        stage('Deploy Locally (Optional)') {
            when { expression { params.DEPLOY == true } }
            steps {
                dir("${env.SERVICE_NAME}") {
                    script {
                        def port = params.PORT
                        if (fileExists('.env')) {
                            def envVars = readFile('.env').split('\n')
                                .findAll { it.contains('=') }
                                .collect { it.split('=') }
                                .collectEntries { [(it[0]): it[1]] }
                            port = envVars['PORT'] ?: params.PORT
                        }

                        sh """
                            docker stop ${env.SERVICE_NAME} || true
                            docker rm ${env.SERVICE_NAME} || true
                            docker run -d --name ${env.SERVICE_NAME} -p ${port}:${port} --env-file .env ${env.SERVICE_NAME}:latest
                        """
                    }
                }
            }
        }
    }

    post {
        success { echo "✅ ${env.SERVICE_NAME} Docker image built and deployed!" }
        failure { echo "❌ ${env.SERVICE_NAME} build/deploy failed!" }
    }
}
